---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SnowScene from '../components/SnowScene.astro';
import { excerpt } from '../lib/format';
import { SITE } from '../data/site';

const all = await getCollection('blog');
const posts = all
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    img: entry.data.img ?? null,
    body: entry.body,
    excerpt: excerpt(entry.body, 148),
  }));

const cvs = (await getCollection('cv')).sort((a, b) => a.data.baseUrl!.localeCompare(b.data.baseUrl!));
const cvMeta: Record<string, { label: string; href: string }> = {
  fullstack: { label: 'Full-Stack', href: '/experience/' },
  frontend: { label: 'Frontend', href: '/experience-front/' },
  backend: { label: 'Backend', href: '/experience-back/' },
};
---

<Base
  title="DevBlog — Evgeny Konoplev"
  description="Personal page of Evgeny Konoplev: engineering notes, pet projects and CV."
>
  <section class="band">
    <div class="wrap band-inner">
      <div class="band-copy">
        <p class="eyebrow">{SITE.location} · Senior Full-Stack / Tech Lead</p>
        <h1>{SITE.title}</h1>
        <ul class="band-points">
          {SITE.topBanner.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <div class="band-aside">
        <dl class="band-stats">
          <div>
            <dt>Experience</dt>
            <dd>15+ yrs</dd>
          </div>
          <div>
            <dt>Notes</dt>
            <dd>{posts.length}</dd>
          </div>
          <div>
            <dt>Teams led</dt>
            <dd>10 eng</dd>
          </div>
        </dl>

        <div class="band-cta">
          <a class="btn btn-primary" href="/experience/">View CV</a>
          <a class="btn" href="https://github.com/evgenykon" target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href="mailto:effusps@gmail.com">Email</a>
        </div>
      </div>
    </div>
  </section>

  <SnowScene posts={posts} />

  <section class="wrap outro">
    <div class="outro-head">
      <span class="eyebrow">CV · 3 angles</span>
      <h2>Same person, three focus points</h2>
      <p>Full-stack lead, frontend architect and backend engineer — pick the one that matches the role.</p>
    </div>

    <div class="cv-grid">
      {
        cvs.map((cv) => (
          <a class="cv-card" href={cvMeta[cv.id]?.href ?? '/'}>
            <span class="chip">{cvMeta[cv.id]?.label ?? cv.id}</span>
            <h3>{cv.data.position}</h3>
            <p>{excerpt(cv.data.annotation, 150)}</p>
            <span class="cv-open">Open CV →</span>
          </a>
        ))
      }
    </div>

    <div class="elsewhere">
      <span class="eyebrow">Elsewhere</span>
      <div class="elsewhere-links">
        <a class="btn" href="https://github.com/evgenykon" target="_blank" rel="noopener">GitHub</a>
        <a class="btn" href="https://www.linkedin.com/in/evgeny-kon/" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href="https://www.hackerrank.com/effusps" target="_blank" rel="noopener">HackerRank</a>
        <a class="btn" href="mailto:effusps@gmail.com">effusps@gmail.com</a>
      </div>
      <p class="bottom-note">{SITE.bottom}</p>
    </div>
  </section>
</Base>

<style>
  /* ---- compact intro band: the feed starts right after it ---- */
  .band {
    position: relative;
    z-index: 1;
    padding: clamp(1.8rem, 4.5vw, 3.2rem) 0 clamp(1rem, 2.5vw, 1.8rem);
  }

  .band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(1.2rem, 3vw, 2.6rem);
    align-items: end;
  }

  h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0.25rem 0 0.9rem;
  }

  .band-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    max-width: 62ch;
  }

  .band-points li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .band-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    transform: rotate(45deg);
  }

  .band-aside {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .band-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: 0;
  }

  .band-stats dt {
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .band-stats dd {
    margin: 0.1rem 0 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .band-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ---- outro ---- */
  .outro {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .outro-head {
    max-width: 60ch;
    margin-bottom: 1.6rem;
  }

  .outro-head h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0.25rem 0 0.5rem;
  }

  .outro-head p {
    color: var(--muted);
  }

  .cv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .cv-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.4rem 1.35rem;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .cv-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    opacity: 1;
  }

  .cv-card h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .cv-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cv-open {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent);
  }

  .elsewhere {
    margin-top: 2.6rem;
    padding: 1.6rem 1.4rem;
    border-radius: 18px;
    border: 1px dashed var(--border-strong);
  }

  .elsewhere-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.7rem 0 1rem;
  }

  .bottom-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 68ch;
  }

  @media (max-width: 899px) {
    .band-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .band-stats {
      gap: 1.1rem;
    }
  }
</style>
