---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlogStream from '../components/BlogStream.astro';
import { excerpt } from '../lib/format';
import { SITE } from '../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const cvs = (await getCollection('cv')).sort((a, b) => a.data.baseUrl!.localeCompare(b.data.baseUrl!));
const cvMeta: Record<string, { label: string; href: string }> = {
  fullstack: { label: 'Full-Stack', href: '/experience/' },
  frontend: { label: 'Frontend', href: '/experience-front/' },
  backend: { label: 'Backend', href: '/experience-back/' },
};
---

<Base
  title="DevBlog"
  description="Engineering notes, pet projects and CV."
>
  <span id="top"></span>

  <section class="band">
    <div class="band-inner">
      <div class="band-copy">
        <h1>{SITE.title}</h1>
        <ul class="band-points">
          {SITE.topBanner.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <BlogStream posts={posts} />

  <section class="wrap outro">
    <div class="cv-block" data-cv-gated hidden>
      <div class="outro-head">
        <span class="eyebrow">CV · 3 angles</span>
        <h2>Same person, three focus points</h2>
        <p>Full-stack lead, frontend architect and backend engineer — pick the one that matches the role.</p>
      </div>

      <div class="cv-grid">
        {
          cvs.map((cv) => (
            <a class="cv-card" href={cvMeta[cv.id]?.href ?? '/'}>
              <span class="chip">{cvMeta[cv.id]?.label ?? cv.id}</span>
              <h3>{cv.data.position}</h3>
              <p>{excerpt(cv.data.annotation, 150)}</p>
              <span class="cv-open">Open CV →</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="elsewhere">
      <span class="eyebrow">Elsewhere</span>
      <div class="elsewhere-links">
        <a class="btn" href="https://github.com/evgenykon" target="_blank" rel="noopener">GitHub</a>
        <a class="btn" href="https://www.linkedin.com/in/evgeny-kon/" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href="https://www.hackerrank.com/effusps" target="_blank" rel="noopener">HackerRank</a>
        <a class="btn" href="mailto:effusps@gmail.com">effusps@gmail.com</a>
      </div>
      <p class="bottom-note">{SITE.bottom}</p>
    </div>
  </section>
</Base>

<style>
  .band {
    position: relative;
    z-index: 2;
    padding: clamp(2rem, 5vw, 3.6rem) 0 clamp(1rem, 2.5vw, 1.8rem);
  }

  .band-inner {
    width: min(780px, 100% - 2.5rem);
    margin-inline: auto;
    display: grid;
    gap: clamp(1.2rem, 3vw, 2rem);
  }

  h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0.25rem 0 0.9rem;
  }

  .band-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    max-width: 62ch;
  }

  .band-points li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .band-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .outro {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .outro-head {
    max-width: 60ch;
    margin-bottom: 1.6rem;
  }

  .outro-head h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0.25rem 0 0.5rem;
  }

  .outro-head p {
    color: var(--muted);
  }

  .cv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .cv-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.4rem 1.35rem;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .cv-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    opacity: 1;
  }

  .cv-card h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .cv-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cv-open {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent);
  }

  .elsewhere {
    margin-top: 2.6rem;
    padding: 1.6rem 1.4rem;
    border-radius: 18px;
    border: 1px dashed var(--border-strong);
  }

  .elsewhere-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.7rem 0 1rem;
  }

  .bottom-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 68ch;
  }

  @media (max-width: 899px) {
    .band-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
