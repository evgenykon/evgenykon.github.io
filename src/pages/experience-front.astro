---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CvView from '../components/CvView.astro';

const cv = await getEntry('cv', 'frontend');
if (!cv) throw new Error('CV entry "frontend" not found');
---

<Base title={`${cv.data.position} — Evgeny Konoplev`} description={cv.data.annotation} footerName="Evgeny Konoplev">
  <CvView cv={cv} />
</Base>
