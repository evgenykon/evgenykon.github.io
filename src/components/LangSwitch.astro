---
interface Props {
  lang: 'en' | 'ru';
  href: string;
}

const { lang, href } = Astro.props;
const label = lang === 'ru' ? 'Переключить на русский' : 'Switch to English';
---

<a class="lang-switch" href={href} aria-label={label} title={label} hreflang={lang}>
  {
    lang === 'ru' ? (
      <svg viewBox="0 0 30 20" aria-hidden="true">
        <rect width="30" height="6.67" y="0" fill="#ffffff" />
        <rect width="30" height="6.66" y="6.67" fill="#0039a6" />
        <rect width="30" height="6.67" y="13.33" fill="#d52b1e" />
      </svg>
    ) : (
      <svg viewBox="0 0 30 20" aria-hidden="true">
        <rect width="30" height="20" fill="#012169" />
        <path d="M0 0 L30 20 M30 0 L0 20" stroke="#ffffff" stroke-width="4" />
        <path d="M0 0 L30 20 M30 0 L0 20" stroke="#c8102e" stroke-width="1.6" />
        <path d="M15 0 V20 M0 10 H30" stroke="#ffffff" stroke-width="6.5" />
        <path d="M15 0 V20 M0 10 H30" stroke="#c8102e" stroke-width="3.6" />
      </svg>
    )
  }
</a>
