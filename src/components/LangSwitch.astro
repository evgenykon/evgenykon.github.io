---
interface Props {
  lang: 'en' | 'ru';
  href: string;
}

const { lang, href } = Astro.props;
const label = lang === 'ru' ? 'Переключить на русский' : 'Switch to English';
const clipId = `uj-${Math.random().toString(36).slice(2, 8)}`;
---

<a class="lang-switch" href={href} aria-label={label} title={label} hreflang={lang}>
  {
    lang === 'ru' ? (
      <svg viewBox="0 0 30 20" aria-hidden="true">
        <rect x="0" y="0" width="30" height="6.6667" fill="#ffffff" />
        <rect x="0" y="6.6667" width="30" height="6.6666" fill="#0032a0" />
        <rect x="0" y="13.3333" width="30" height="6.6667" fill="#da291c" />
      </svg>
    ) : (
      <svg viewBox="0 0 60 40" aria-hidden="true">
        <clipPath id={clipId}>
          <path d="M30 20 h30 v20 z v20 h-30 z h-30 v-20 z v-20 h30 z" />
        </clipPath>
        <rect width="60" height="40" fill="#012169" />
        <path d="M0 0 L60 40 M60 0 L0 40" stroke="#ffffff" stroke-width="8" />
        <path
          d="M0 0 L60 40 M60 0 L0 40"
          clip-path={`url(#${clipId})`}
          stroke="#c8102e"
          stroke-width="5.4"
        />
        <path d="M30 0 V40 M0 20 H60" stroke="#ffffff" stroke-width="13.4" />
        <path d="M30 0 V40 M0 20 H60" stroke="#c8102e" stroke-width="8" />
      </svg>
    )
  }
</a>
