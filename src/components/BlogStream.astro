---
import '../styles/stream.css';
import { render, type CollectionEntry } from 'astro:content';
import { formatDate, isoDate, readingTime } from '../lib/format';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    Content: (await render(post)).Content,
  })),
);
const n = posts.length;
---

<section class="stream" id="feed">
  <div class="stream-grid">
    <div class="stream-main">
      {
        items.map(({ post, Content }, i) => (
          <>
            {i > 0 && <div class="post-gap" data-gap aria-hidden="true" />}
            <article class="post-full" id={`post-${post.id}`} data-post>
              <header class="post-head">
                <div class="post-index">
                  {String(i + 1).padStart(2, '0')} / {String(n).padStart(2, '0')}
                </div>
                <div class="post-meta">
                  <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                  <span class="dot">·</span>
                  <span>{readingTime(post.body)} min read</span>
                </div>
                <h2>
                  <a href={`#post-${post.id}`}>{post.data.title}</a>
                </h2>
              </header>

              {post.data.img && <img class="post-hero" src={post.data.img} alt={post.data.title} />}

              <div class="prose">
                <Content />
              </div>

              <footer class="post-foot">
                <a class="post-anchor" href={`#post-${post.id}`}>
                  #{String(i + 1).padStart(2, '0')} · {formatDate(post.data.date)}
                </a>
                <a class="post-anchor" href="#top">back to top ↑</a>
              </footer>
            </article>
          </>
        ))
      }
    </div>

    <aside class="rail" aria-hidden="true">
      <div class="rail-sticky" data-rail>
        <div class="slope"></div>

        <div class="rail-gates">
          {[0, 1, 2, 3, 4, 5].map(() => <span class="rail-gate" data-gate />)}
        </div>

        <div class="rail-snow">
          {
            Array.from({ length: 14 }).map((_, i) => (
              <i style={`--x:${(i * 67) % 100}%;--d:${10 + (i % 6)}s;--dl:${(i * 0.8).toFixed(1)}s;--s:${1 + (i % 3)}px`} />
            ))
          }
        </div>

        <svg class="fx" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path data-arc class="fx-arc" d="" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="ramp" data-ramp></div>
        <div class="burst" data-burst></div>

        <div class="spray">
          {Array.from({ length: 10 }).map(() => <span data-spray-dot />)}
        </div>

        <div class="rider-shadow" data-shadow></div>

        <div class="rider" data-rider>
          <svg class="rider-svg" viewBox="0 0 220 220">
            <defs>
              <linearGradient id="br-board" x1="0" y1="0" x2="1" y2="0.4">
                <stop offset="0" stop-color="#6fe9ff"></stop>
                <stop offset="0.55" stop-color="#5ee7ff"></stop>
                <stop offset="1" stop-color="#a78bfa"></stop>
              </linearGradient>
              <linearGradient id="br-jacket" x1="0.1" y1="0" x2="0.9" y2="1">
                <stop offset="0" stop-color="#ffffff"></stop>
                <stop offset="0.6" stop-color="#dbe6f6"></stop>
                <stop offset="1" stop-color="#93a7c4"></stop>
              </linearGradient>
              <linearGradient id="br-pants-near" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#4d6390"></stop>
                <stop offset="1" stop-color="#1a2440"></stop>
              </linearGradient>
              <linearGradient id="br-pants-far" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#33456a"></stop>
                <stop offset="1" stop-color="#101a30"></stop>
              </linearGradient>
              <linearGradient id="br-helmet" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#4b6293"></stop>
                <stop offset="1" stop-color="#0e1626"></stop>
              </linearGradient>
            </defs>

            <g data-spin>
              <!-- BOARD: isometric top face + visible side edge -->
              <g data-board>
                <path d="M 46 166 L 176 150 L 176 157 L 46 173 Z" fill="#0a1020" opacity="0.9"></path>
                <path
                  d="M 44 152 L 166 136 Q 180 134 181 145 Q 182 156 168 158 L 46 174 Q 34 175 34 164 Q 34 153 44 152 Z"
                  fill="url(#br-board)"
                  stroke="#050a14"
                  stroke-width="2"
                ></path>
                <path d="M 46 156 L 168 141" stroke="#ffffff" stroke-width="3" opacity="0.35" stroke-linecap="round"></path>

                <!-- bindings -->
                <path d="M 66 158 L 88 155 L 88 168 L 66 171 Z" fill="#0b1220"></path>
                <path d="M 132 149 L 154 146 L 154 159 L 132 162 Z" fill="#0b1220"></path>
              </g>

              <!-- FAR LEG (further from camera: smaller, darker) -->
              <g data-thigh-back>
                <path d="M 104 124 L 92 142" stroke="url(#br-pants-far)" stroke-width="12" stroke-linecap="round"></path>
                <g data-shin-back>
                  <path d="M 92 142 L 80 156" stroke="url(#br-pants-far)" stroke-width="10" stroke-linecap="round"></path>
                  <path d="M 68 156 L 88 152 L 88 165 L 68 169 Z" fill="#16203a"></path>
                </g>
              </g>

              <!-- NEAR LEG (closer: thicker, lighter) -->
              <g data-thigh-front>
                <path d="M 112 126 L 132 146" stroke="url(#br-pants-near)" stroke-width="15" stroke-linecap="round"></path>
                <g data-shin-front>
                  <path d="M 132 146 L 145 158" stroke="url(#br-pants-near)" stroke-width="12" stroke-linecap="round"></path>
                  <path d="M 134 152 L 156 149 L 156 163 L 134 166 Z" fill="#1b2742"></path>
                </g>
              </g>

              <!-- TORSO + ARMS + HEAD (turned 3/4 to the right) -->
              <g data-torso>
                <path
                  d="M 98 130 Q 92 108 104 92 L 130 86 Q 140 106 134 130 Z"
                  fill="url(#br-jacket)"
                  stroke="#0a1428"
                  stroke-width="2"
                ></path>
                <path d="M 106 94 L 128 88" stroke="#5ee7ff" stroke-width="5" opacity="0.5" stroke-linecap="round"></path>
                <path d="M 118 96 L 126 124" stroke="#8fa3bf" stroke-width="2" opacity="0.55"></path>

                <!-- far arm -->
                <g data-arm-back>
                  <path d="M 106 94 L 92 104" stroke="#c3d2e6" stroke-width="9" stroke-linecap="round"></path>
                  <path d="M 92 104 L 84 116" stroke="#b3c3da" stroke-width="8" stroke-linecap="round"></path>
                  <circle cx="82" cy="119" r="5.5" fill="#16203a" stroke="#5ee7ff" stroke-width="1.4"></circle>
                </g>

                <!-- near arm -->
                <g data-arm-front>
                  <path d="M 128 92 L 144 104" stroke="#eef5ff" stroke-width="11" stroke-linecap="round"></path>
                  <path d="M 144 104 L 152 117" stroke="#dbe7f7" stroke-width="9" stroke-linecap="round"></path>
                  <circle cx="154" cy="120" r="6" fill="#16203a" stroke="#5ee7ff" stroke-width="1.6"></circle>
                </g>

                <!-- head, turned down the slope -->
                <circle cx="120" cy="74" r="14" fill="url(#br-helmet)" stroke="#050a14" stroke-width="2"></circle>
                <path d="M 107 68 a14 14 0 0 1 25 -3" fill="#5a719c" opacity="0.6"></path>
                <g transform="rotate(14 122 76)">
                  <rect x="110" y="71" width="24" height="9" rx="4.5" fill="#5ee7ff"></rect>
                  <rect x="110" y="71" width="24" height="3" rx="1.5" fill="#ffffff" opacity="0.55"></rect>
                </g>

                <!-- scarf trailing behind -->
                <path d="M 104 92 C 92 100, 100 112, 88 118" stroke="#5ee7ff" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.55"></path>
              </g>
            </g>
          </svg>
        </div>

        <div class="trick-label" data-trick-label>360° spin</div>

        <div class="rail-hud">
          <b data-hud-num>01</b>
          <i>/ {String(n).padStart(2, '0')}</i>
          <span class="hud-bar"><span data-hud-fill></span></span>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  import { initBlogRail } from '../scripts/blog-rail';
  initBlogRail();
</script>
