---
import '../styles/stream.css';
import { render } from 'astro:content';
import { formatDate, isoDate, readingTime } from '../lib/format';
import { t as dict, type Lang } from '../i18n/ui';
import type { BlogEntry } from '../lib/posts';

interface Props {
  posts: BlogEntry[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = dict(lang);
const base = lang === 'ru' ? '/ru/' : '/';

const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    Content: (await render(post as never)).Content,
  })),
);
const n = posts.length;
---

<section class="stream" id="feed">
  <div class="stream-inner">
    {
      items.map(({ post, Content }, i) => (
        <>
          {i > 0 && <div class="post-gap" aria-hidden="true" />}
          <article class="post-full" id={`post-${post.id}`} data-post>
            <header class="post-head">
              <div class="post-index">
                {String(i + 1).padStart(2, '0')} {t.postOf} {String(n).padStart(2, '0')}
              </div>
              <div class="post-meta">
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time>
                <span class="dot">·</span>
                <span>{readingTime(post.body)} {t.minRead}</span>
              </div>
              <h2>
                <a href={`${base}#post-${post.id}`}>{post.data.title}</a>
              </h2>
            </header>

            {post.data.img && <img class="post-hero" src={post.data.img} alt={post.data.title} />}

            <div class="prose">
              <Content />
            </div>

            <footer class="post-foot">
              <a class="post-anchor" href={`${base}#post-${post.id}`}>
                #{String(i + 1).padStart(2, '0')} · {formatDate(post.data.date, lang)}
              </a>
              <a class="post-anchor" href="#top">{t.backToTop}</a>
            </footer>
          </article>
        </>
      ))
    }
  </div>
</section>
