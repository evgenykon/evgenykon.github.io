---
import '../styles/stream.css';
import { render, type CollectionEntry } from 'astro:content';
import { formatDate, isoDate, readingTime } from '../lib/format';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    Content: (await render(post)).Content,
  })),
);
const n = posts.length;
---

<section class="stream" id="feed">
  <div class="stream-inner">
    {
      items.map(({ post, Content }, i) => (
        <>
          {i > 0 && <div class="post-gap" aria-hidden="true" />}
          <article class="post-full" id={`post-${post.id}`} data-post>
            <header class="post-head">
              <div class="post-index">
                {String(i + 1).padStart(2, '0')} / {String(n).padStart(2, '0')}
              </div>
              <div class="post-meta">
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <span class="dot">·</span>
                <span>{readingTime(post.body)} min read</span>
              </div>
              <h2>
                <a href={`#post-${post.id}`}>{post.data.title}</a>
              </h2>
            </header>

            {post.data.img && <img class="post-hero" src={post.data.img} alt={post.data.title} />}

            <div class="prose">
              <Content />
            </div>

            <footer class="post-foot">
              <a class="post-anchor" href={`#post-${post.id}`}>
                #{String(i + 1).padStart(2, '0')} · {formatDate(post.data.date)}
              </a>
              <a class="post-anchor" href="#top">back to top ↑</a>
            </footer>
          </article>
        </>
      ))
    }
  </div>
</section>
