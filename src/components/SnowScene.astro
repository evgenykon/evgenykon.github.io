---
import '../styles/scene.css';
import { formatDate, isoDate, readingTime } from '../lib/format';

export interface ScenePost {
  id: string;
  title: string;
  date: Date;
  excerpt: string;
  body?: string;
  img?: string | null;
}

interface Props {
  posts: ScenePost[];
}

const { posts } = Astro.props;
const n = posts.length;
---

<header class="scene-intro wrap">
  <span class="eyebrow">DevBlog · {n} entries</span>
  <h2>Ride the feed</h2>
  <p>Newest first. On a big screen the rider works the slope between the notes — on a phone it's a plain feed.</p>
</header>

<section class="snow-stage" data-stage style={`--slides:${n + 1}`} id="feed">
  <div class="stage-sticky" data-sticky>
    <div class="stage-watermark" data-watermark aria-hidden="true">
      <span>DEV</span>
      <span>NOTES</span>
    </div>

    <div class="snowfall" aria-hidden="true">
      {
        Array.from({ length: 16 }).map((_, i) => (
          <i style={`--x:${(i * 61) % 100}%;--d:${9 + (i % 6)}s;--dl:${(i * 0.7).toFixed(1)}s;--s:${1 + (i % 3)}px`} />
        ))
      }
    </div>

    <div class="slope" aria-hidden="true">
      <div class="gates">
        {[0, 1, 2, 3, 4, 5].map(() => (
          <div class="gate" data-gate>
            <span class="gate-pole left"></span>
            <span class="gate-line"></span>
            <span class="gate-pole right"></span>
          </div>
        ))}
      </div>

      <div class="trail-rail" data-rail></div>
      <div class="trail-rail center" data-rail></div>

      <div class="spray">
        {Array.from({ length: 8 }).map(() => <span data-spray-dot></span>)}
      </div>

      <div class="rider">
        <div class="rider-shadow" data-shadow></div>
        <svg class="rider-svg" viewBox="0 0 220 220" aria-hidden="true">
          <defs>
            <linearGradient id="ss-board" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7df0ff"></stop>
              <stop offset="0.55" stop-color="#5ee7ff"></stop>
              <stop offset="1" stop-color="#a78bfa"></stop>
            </linearGradient>
            <linearGradient id="ss-jacket" x1="0" y1="0" x2="0.2" y2="1">
              <stop offset="0" stop-color="#f7fbff"></stop>
              <stop offset="1" stop-color="#9fb2cd"></stop>
            </linearGradient>
            <linearGradient id="ss-pants" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#33456a"></stop>
              <stop offset="1" stop-color="#16203a"></stop>
            </linearGradient>
            <linearGradient id="ss-helmet" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#3a4f78"></stop>
              <stop offset="1" stop-color="#111a2e"></stop>
            </linearGradient>
          </defs>

          <g data-rider-body>
            <!-- board: nose up-screen, tail down-screen -->
            <g data-board>
              <rect x="87" y="32" width="46" height="156" rx="23" fill="url(#ss-board)" stroke="#050a14" stroke-width="3"></rect>
              <rect x="93" y="40" width="34" height="20" rx="10" fill="#ffffff" opacity="0.45"></rect>
              <rect x="93" y="160" width="34" height="16" rx="8" fill="#ffffff" opacity="0.18"></rect>
              <rect x="82" y="75" width="56" height="16" rx="7" fill="#0b1220"></rect>
              <rect x="82" y="129" width="56" height="16" rx="7" fill="#0b1220"></rect>
              <circle cx="110" cy="118" r="3.4" fill="#5ee7ff" opacity="0.85"></circle>
            </g>

            <!-- boots + legs -->
            <path d="M104 112 L100 88" stroke="url(#ss-pants)" stroke-width="13" stroke-linecap="round"></path>
            <path d="M116 112 L120 133" stroke="url(#ss-pants)" stroke-width="13" stroke-linecap="round"></path>
            <rect x="93" y="78" width="22" height="11" rx="5" fill="#22304a"></rect>
            <rect x="105" y="131" width="22" height="11" rx="5" fill="#22304a"></rect>

            <!-- torso -->
            <rect x="93" y="68" width="34" height="50" rx="16" fill="url(#ss-jacket)" stroke="#0a1428" stroke-width="2"></rect>
            <rect x="101" y="68" width="18" height="8" rx="4" fill="#5ee7ff" opacity="0.55"></rect>
            <path d="M100 96 L120 96" stroke="#5b708f" stroke-width="2" opacity="0.7"></path>

            <!-- arms -->
            <path d="M97 80 L76 106" stroke="#e3edfa" stroke-width="10" stroke-linecap="round"></path>
            <path d="M123 80 L144 106" stroke="#e3edfa" stroke-width="10" stroke-linecap="round"></path>
            <circle cx="74" cy="110" r="6" fill="#16203a" stroke="#5ee7ff" stroke-width="1.6"></circle>
            <circle cx="146" cy="110" r="6" fill="#16203a" stroke="#5ee7ff" stroke-width="1.6"></circle>

            <!-- scarf -->
            <path d="M110 72 C 122 92, 104 108, 118 128" stroke="#5ee7ff" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.6"></path>

            <!-- head -->
            <circle cx="110" cy="58" r="15" fill="url(#ss-helmet)" stroke="#050a14" stroke-width="2"></circle>
            <path d="M96 52 a14 14 0 0 1 28 0" fill="#4a628f" opacity="0.7"></path>
            <rect x="99" y="54" width="22" height="9" rx="4.5" fill="#5ee7ff"></rect>
            <rect x="99" y="54" width="22" height="3.5" rx="1.75" fill="#ffffff" opacity="0.5"></rect>
          </g>
        </svg>
      </div>

      <div class="trick-label" data-trick-label>360° spin</div>
    </div>

    <div class="feed" data-feed>
      {
        posts.map((post, i) => (
          <a class="gate-card" data-card href={`/blog/${post.id}/`}>
            <span class="gate-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {post.img && <span class="gate-thumb" style={`background-image:url(${post.img})`} />}
            <div class="gate-meta">
              <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
              <span class="chip">{readingTime(post.body)} min</span>
            </div>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <span class="gate-link">
              Read post
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <div class="stage-hud" data-hud aria-hidden="true">
      <span class="hud-index"><b data-hud-num>01</b><i>/ {String(n).padStart(2, '0')}</i></span>
      <span class="hud-bar"><span data-hud-fill></span></span>
    </div>

    <div class="scroll-hint" data-hint>scroll to ride</div>
  </div>
</section>

<script>
  import { initSnowScene } from '../scripts/snow-scene';
  initSnowScene();
</script>
