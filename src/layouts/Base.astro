---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  footerName?: string;
}

const {
  title = 'DevBlog',
  description = 'Engineering notes, pet projects and CV.',
  footerName,
} = Astro.props;

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')) && href !== '/';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#141414" />
  </head>
  <body>
    <canvas class="fluid" data-fluid aria-hidden="true"></canvas>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">EK</span>
          <span>evgeny.kon</span>
        </a>

        <nav class="nav" aria-label="Main">
          <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Blog</a>

          <details class="nav-drop">
            <summary>Pet Projects</summary>
            <div class="nav-drop-menu">
              {
                SITE.projects.map((project) => (
                  <a href={project.href} target="_blank" rel="noopener">
                    {project.label}
                  </a>
                ))
              }
            </div>
          </details>

          <a
            href="/experience/"
            aria-current={isCurrent('/experience/') ? 'page' : undefined}
            data-cv-gated
            hidden
          >
            CV
          </a>

          <a href="https://github.com/evgenykon" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()}{footerName ? ` ${footerName}` : ''} · built with Astro</span>
        <span>
          <a href="mailto:effusps@gmail.com">effusps@gmail.com</a>
          · <a href="https://github.com/evgenykon" target="_blank" rel="noopener">GitHub</a>
          · <a href="https://www.linkedin.com/in/evgeny-kon/" target="_blank" rel="noopener">LinkedIn</a>
        </span>
      </div>
    </footer>

    <script>
      import { initFluidBackground } from '../scripts/fluid-bg';

      initFluidBackground();

      /* CV links are opt-in: they only appear with ?cv=1 in the URL */
      if (new URLSearchParams(location.search).get('cv') === '1') {
        document.querySelectorAll<HTMLElement>('[data-cv-gated]').forEach((el) => {
          el.removeAttribute('hidden');
        });
      }

      /* close the projects dropdown when clicking elsewhere */
      const drop = document.querySelector<HTMLDetailsElement>('.nav-drop');
      if (drop) {
        document.addEventListener('click', (event) => {
          if (!drop.contains(event.target as Node)) drop.open = false;
        });
      }
    </script>
  </body>
</html>
