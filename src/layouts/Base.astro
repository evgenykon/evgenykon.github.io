---
import '../styles/global.css';
import { SITE } from '../data/site';
import LangSwitch from '../components/LangSwitch.astro';
import { t as dict, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  footerName?: string;
}

const { lang = defaultLang, title, description, footerName } = Astro.props;
const t = dict(lang);

const pageTitle = title ?? t.title;
const pageDescription = description ?? t.description;

const base = lang === 'ru' ? '/ru/' : '/';
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')) && href !== '/';

const site = Astro.site ?? new URL('https://evgenykon.github.io');
const altRu = new URL('/ru/', site).href;
const altEn = new URL('/', site).href;
---

<!doctype html>
<html lang={t.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="ru" href={altRu} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={t.htmlLang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#141414" />
  </head>
  <body>
    <canvas class="fluid" data-fluid aria-hidden="true"></canvas>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true">EK</span>
          <span>evgeny.kon</span>
        </a>

        <nav class="nav" aria-label="Main">
          <a href={base} aria-current={isCurrent('/') ? 'page' : undefined}>{t.navBlog}</a>

          <details class="nav-drop">
            <summary>{t.navProjects}</summary>
            <div class="nav-drop-menu">
              {
                SITE.projects.map((project) => (
                  <a href={project.href} target="_blank" rel="noopener">
                    {project.label}
                  </a>
                ))
              }
            </div>
          </details>

          <a
            href="/experience/"
            aria-current={isCurrent('/experience/') ? 'page' : undefined}
            data-cv-gated
            hidden
          >
            {t.navCv}
          </a>

          <a href="https://github.com/evgenykon" target="_blank" rel="noopener">{t.navGithub}</a>

          <LangSwitch lang={lang === 'ru' ? 'en' : 'ru'} href={t.switchHref} />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()}{footerName ? ` ${footerName}` : ''} · {t.builtWith}</span>
        <span>
          <a href="mailto:effusps@gmail.com">effusps@gmail.com</a>
          · <a href="https://github.com/evgenykon" target="_blank" rel="noopener">GitHub</a>
          · <a href="https://www.linkedin.com/in/evgeny-kon/" target="_blank" rel="noopener">LinkedIn</a>
        </span>
      </div>
    </footer>

    <script>
      import { initFluidBackground } from '../scripts/fluid-bg';

      initFluidBackground();

      /* CV links are opt-in: they only appear with ?cv=1 in the URL */
      if (new URLSearchParams(location.search).get('cv') === '1') {
        document.querySelectorAll<HTMLElement>('[data-cv-gated]').forEach((el) => {
          el.removeAttribute('hidden');
        });
      }

      /* close the projects dropdown when clicking elsewhere */
      const drop = document.querySelector<HTMLDetailsElement>('.nav-drop');
      if (drop) {
        document.addEventListener('click', (event) => {
          if (!drop.contains(event.target as Node)) drop.open = false;
        });
      }
    </script>
  </body>
</html>
